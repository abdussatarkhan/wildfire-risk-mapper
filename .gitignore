# Raw and intermediate data
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/README.md

# Large files & geospatial binaries
*.csv
*.parquet
*.pkl
*.h5
*.tif
*.tiff
*.geotiff
*.img
*.nc
*.gpkg
*.tar.gz
*.zip

# Environment & credentials
.env
.env.*
secrets.yaml

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*-checkpoint.py

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Models & outputs
models/*.joblib
models/*.pkl
models/*.onnx
!models/.gitkeep
images/*.png
images/*.jpg
!images/.gitkeep
outputs/
logs/
*.log
